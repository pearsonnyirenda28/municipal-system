# .htaccess
# Improvement 19: Deployment - hardening for a real Apache/XAMPP deploy.
# None of this matters for the PHP built-in dev server (php -S), which
# ignores .htaccess entirely - it only takes effect once this sits in
# htdocs under real Apache, which is the point: a school project marked
# "complete" only when it's actually deployable, not just runnable
# locally via `php -S`.

# ------------------------------------------------------------
# Block direct access to anything that is data, not application code.
# ------------------------------------------------------------
<FilesMatch "\.(env|sqlite|sqlite-journal|db|log|sql)$">
    Require all denied
</FilesMatch>

<Files "error_log.txt">
    Require all denied
</Files>

RedirectMatch 404 /\.git

Options -Indexes

# ------------------------------------------------------------
# Basic security headers + Content Security Policy.
# ------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # NOTE: do NOT set a Content-Security-Policy here.
    # The one authoritative policy is sent by PHP in includes/db.php. Browsers
    # enforce the INTERSECTION of every CSP header on a response, so a second,
    # narrower policy here (without 'unsafe-inline') silently blocks the inline
    # <script> blocks that hand the CSRF token to the sync layer, and every
    # inline onclick/onchange handler - which showed up as "window.CSRF_TOKEN
    # is not set" and failed syncs.
</IfModule>

# ------------------------------------------------------------
# WebAssembly MIME type (for sql-wasm.wasm).
# ------------------------------------------------------------
AddType application/wasm .wasm

# ------------------------------------------------------------
# Force HTTPS - commented out for local XAMPP dev.
# ------------------------------------------------------------
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>