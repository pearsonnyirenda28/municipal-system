# Copy this file to .env and edit as needed.
# .env itself is listed in .gitignore and will NOT be uploaded to GitHub -
# that's exactly the point, so your real settings/keys never end up in
# a public repository.

# Database driver: sqlite (default, no server needed) or mysql
DB_DRIVER=sqlite

# Used only when DB_DRIVER=sqlite
DB_PATH=data/municipal_system.sqlite

# Used only when DB_DRIVER=mysql
DB_HOST=localhost
DB_NAME=municipal_system
DB_USER=root
DB_PASS=

APP_ENV=local

# Reserved for Chapter 7's future plans (e.g. an SMS gateway for fine/
# meter-reading notifications). Leave blank until you actually have one.
SMS_GATEWAY_API_KEY=

# ------------------------------------------------------------
# Workstation <-> central Workspace Server sync (Version 4.5).
# Leave these blank/default for a single standalone install - the app
# and every offline-capable feature (readings, fines, visit status)
# works exactly the same either way, since local SQLite/MySQL is
# already what every page reads and writes directly (see DB_DRIVER
# above). These only matter once you're running MORE THAN ONE
# workstation and want them to consolidate into one central MySQL -
# see README.md, "Deploying more than one workstation".
# ------------------------------------------------------------

# A name for THIS workstation - shows up on synced records so you can
# tell which physical machine/office a reading or fine came from.
DEVICE_ID=WORKSTATION-01

# The Workspace Server's BASE URL (no trailing path) - only needed on a
# FIELD WORKSTATION. Leave blank on the Workspace Server itself, and
# blank everywhere until you have a real central server to point at;
# cli_sync_engine.php just idles with nothing configured.
# Example: CENTRAL_SERVER_URL=http://192.168.1.10/municipal-system
CENTRAL_SERVER_URL=

# Shared secret BOTH the workstation and the Workspace Server must have
# set to the SAME value - required before api/sync_push.php or
# api/sync_pull.php will accept anything (see includes/central_store.php).
# Generate one with: php -r "echo bin2hex(random_bytes(24));"
SYNC_API_KEY=

# Tunables for cli_sync_engine.php - safe to leave at their defaults.
SYNC_BATCH_SIZE=50
SYNC_POLL_SECONDS=5
SYNC_PULL_EVERY_N_POLLS=12
SYNC_MAX_ATTEMPTS=8

# Session security (all optional).
# Idle timeout in minutes (default 15). A small value such as 1 is handy for
# demonstrating the automatic logout.
SESSION_TIMEOUT_MINUTES=15
# How often (seconds) a live session is re-checked against the Users table, so
# deactivating an account or changing its password ends sessions already open.
SESSION_REVALIDATE_SECONDS=30
