# Copy this file to .env and edit as needed.
# .env itself is listed in .gitignore and will NOT be uploaded to GitHub -
# that's exactly the point, so your real settings/keys never end up in
# a public repository.

# Database driver: sqlite (default, no server needed) or mysql
DB_DRIVER=sqlite

# Used only when DB_DRIVER=sqlite
DB_PATH=data/municipal_system.sqlite

# Used only when DB_DRIVER=mysql
DB_HOST=localhost
DB_NAME=municipal_system
DB_USER=root
DB_PASS=

APP_ENV=local

# Reserved for Chapter 7's future plans (e.g. an SMS gateway for fine/
# meter-reading notifications). Leave blank until you actually have one.
SMS_GATEWAY_API_KEY=
